# Board-specific runtime additions. The common boot and security floor lives
# only in common/kernel/mica-required.fragment. Native netavark nftables,
# conntrack, NAT, FIB and veth requirements belong to that shared floor.

# Retained vendor/iptables-compatibility netfilter options. They are not part
# of netavark's native nftables transaction above.
CONFIG_NFT_COMPAT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_XFRM=y
CONFIG_BRIDGE_NETFILTER=y

# Optional container network drivers. They are not needed before the root is
# mounted and therefore remain modules.
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
